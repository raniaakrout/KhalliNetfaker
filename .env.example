# =============================================================================
# KhalliNetfaker - Environment Variables Configuration
# ============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (OpenRouter)
# -----------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI API key (use same as OpenRouter for DeepEval compatibility)
OPENAI_API_KEY=sk-or-v1-your-key-here

# Optional: Groq API key if using Groq models
# GROQ_API_KEY=gsk_your-groq-key-here

# -----------------------------------------------------------------------------
# Embeddings Configuration
# -----------------------------------------------------------------------------
# HuggingFace embedding model for semantic search
# Option: sentence-transformers/all-MiniLM-L6-v2 
#          
EMBEDDING_MODEL=your_embedding_model

# Semantic chunking configuration
# Type: percentile  | standard_deviation | interquartile
BREAKPOINT_THRESHOLD_TYPE=percentile

# Amount: 95 (recommended for percentile) | 3 (for std_dev) | 1.5 (for IQR)
BREAKPOINT_THRESHOLD_AMOUNT=95

# -----------------------------------------------------------------------------
# Judge Model (LLM-as-Judge for Evaluation)
# -----------------------------------------------------------------------------

JUDGE_MODEL=your_model

# Evaluation thresholds (0.0 - 1.0)
JUDGE_THRESHOLD_FAITHFULNESS=0.5
JUDGE_THRESHOLD_RELEVANCY=0.5
JUDGE_THRESHOLD_PRECISION=0.5

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=num_port 
DB_NAME=meeting_minutes_db
DB_USER=user_name
DB_PASSWORD=your_secure_password_here


# -----------------------------------------------------------------------------
# JWT Authentication

JWT_SECRET_KEY=your-secret-key-here-replace-with-random-string

# JWT algorithm (default: HS256)
JWT_ALGORITHM=*****

# Token expiration in minutes 
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=***


# -----------------------------------------------------------------------------
#  Advanced Configuration
# -----------------------------------------------------------------------------
# LLM generation model 
# LLM_MODEL=****

# Temperature for RAG generation (0.0 = deterministic)
# LLM_TEMPERATURE=0.0

# Max tokens for generation
# LLM_MAX_TOKENS=****

# Top-K for RAG retrieval 
# RAG_TOP_K=***


