# =============================================================================
# KhalliNetfaker - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Backend: meeting_rag/.env
# Frontend: transcript-upload-pipeline/.env.local
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (OpenRouter)
# -----------------------------------------------------------------------------
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI API key (use same as OpenRouter for DeepEval compatibility)
OPENAI_API_KEY=sk-or-v1-your-key-here

# Optional: Groq API key if using Groq models
# GROQ_API_KEY=gsk_your-groq-key-here

# -----------------------------------------------------------------------------
# Embeddings Configuration
# -----------------------------------------------------------------------------
# HuggingFace embedding model for semantic search
# Options: sentence-transformers/all-MiniLM-L6-v2 (fast, recommended)
#          sentence-transformers/all-mpnet-base-v2 (more accurate, slower)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Semantic chunking configuration
# Type: percentile (recommended) | standard_deviation | interquartile
BREAKPOINT_THRESHOLD_TYPE=percentile

# Amount: 95 (recommended for percentile) | 3 (for std_dev) | 1.5 (for IQR)
BREAKPOINT_THRESHOLD_AMOUNT=95

# -----------------------------------------------------------------------------
# Judge Model (LLM-as-Judge for Evaluation)
# -----------------------------------------------------------------------------
# Separate model for evaluation to avoid self-evaluation bias
# Recommended: google/gemma-3-27b-it:free (free, good quality)
# Alternatives: gpt-4o-mini, claude-3-haiku
JUDGE_MODEL=google/gemma-3-27b-it:free

# Evaluation thresholds (0.0 - 1.0)
JUDGE_THRESHOLD_FAITHFULNESS=0.5
JUDGE_THRESHOLD_RELEVANCY=0.5
JUDGE_THRESHOLD_PRECISION=0.5

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meeting_minutes_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Full connection string (alternative to separate fields)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/meeting_minutes_db

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-replace-with-random-string

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Token expiration in minutes (default: 30)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Environment: development | production
ENVIRONMENT=development

# API base URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Optional: Advanced Configuration
# -----------------------------------------------------------------------------
# LLM generation model (default configured in code)
# LLM_MODEL=anthropic/claude-3-5-sonnet

# Temperature for RAG generation (0.0 = deterministic, recommended)
# LLM_TEMPERATURE=0.0

# Max tokens for generation
# LLM_MAX_TOKENS=2048

# Top-K for RAG retrieval (default: 4)
# RAG_TOP_K=4

# Logging level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. Never commit .env files to Git (already in .gitignore)
# 2. Use strong passwords for production databases
# 3. Rotate JWT_SECRET_KEY regularly in production
# 4. Consider using environment-specific .env files:
#    - .env.development
#    - .env.production
#    - .env.test
